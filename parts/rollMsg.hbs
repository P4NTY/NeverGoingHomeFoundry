<div class="rollMsg" data-rra="{{rra}}">
    <p><b>{{name}}</b>: {{skill}}</p>
    <p class="result">
        <b>{{success}}</b>
        {{{diceIcons}}}
    </p>
    <div>
        <button
            data-action="modRoll"
            data-pool="{{pool}}"
            data-skill="{{skill}}"
            data-diceArray="{{diceArray}}"
        > Modyfikuj: {{pool}}
        </button>
    </div>
</div>