<div style="--ruin: {{system.ruin.curr}}">
    <div>
        <section class="stats">
            <h3>
                Rekrutacja
                <label> 
                    <input
                        type="checkbox"
                        name="system.isLocked"
                        {{#if system.isLocked}}checked{{/if}}
                    />
                    {{#if system.isLocked}}
                    <i class="fa-solid fa-lock"></i>
                    {{else}}
                    <i class="fa-solid fa-lock-open"></i>
                    {{/if}}
                </label>
            </h3>
            <ul>
                <li>
                    <div>
                        <h4>Krzepa</h4>
                        <p>Siła, Zwinność, Szybkość</p>
                    </div>
                    {{#if system.isLocked}}
                    <div class="curr">
                        <label>
                            <input
                                type="radio"
                                name="system.stats.Krzepa.curr"
                                value="0"
                                {{#if (isEqual system.stats.Krzepa.curr 0)}}checked{{/if}}
                            >
                            <i class="fa-solid fa-skull"></i>
                        </label>
                        {{{loopTrack 1 system.stats.Krzepa.orgin system.stats.Krzepa.curr "system.stats.Krzepa.curr" "desc"}}}
                    </div>
                    {{/if}}
                    <div class="orgin {{#if system.isLocked}}disabled{{/if}}">
                        {{{loopTrack 0 system.stats.Krzepa.max system.stats.Krzepa.orgin "system.stats.Krzepa.orgin" "desc"}}}
                    </div>
                </li>
                <li>
                    <div>
                        <h4>Spryt</h4>
                        <p>Pamięć, Nauka, Zmysły</p>
                    </div>
                    {{#if system.isLocked}}
                    <div class="curr">
                        <label>
                            <input
                                type="radio"
                                name="system.stats.Spryt.curr"
                                value="0"
                                {{#if (isEqual system.stats.Spryt.curr 0)}}checked{{/if}}
                            >
                            <i class="fa-solid fa-skull"></i>
                        </label>
                        {{{loopTrack 1 system.stats.Spryt.orgin system.stats.Spryt.curr "system.stats.Spryt.curr" "desc"}}}
                    </div>
                    {{/if}}
                    <div class="orgin {{#if system.isLocked}}disabled{{/if}}">
                        {{{loopTrack 0 system.stats.Spryt.max system.stats.Spryt.orgin "system.stats.Spryt.orgin" "desc"}}}
                    </div>
                </li>
                <li>
                    <div>
                        <h4>Hart</h4>
                        <p>Odwaga, Wytrzymałość, Emocje</p>
                    </div>
                    {{#if system.isLocked}}
                    <div class="curr">
                        <label>
                            <input
                                type="radio"
                                name="system.stats.Hart.curr"
                                value="0"
                                {{#if (isEqual system.stats.Hart.curr 0)}}checked{{/if}}
                            >
                            <i class="fa-solid fa-skull"></i>
                        </label>
                        {{{loopTrack 1 system.stats.Hart.orgin system.stats.Hart.curr "system.stats.Hart.curr" "desc"}}}
                    </div>
                    {{/if}}
                    <div class="orgin {{#if system.isLocked}}disabled{{/if}}">
                        {{{loopTrack 0 system.stats.Hart.max system.stats.Hart.orgin "system.stats.Hart.orgin" "desc"}}}
                    </div>
                </li>
            </ul>
        </section>
        <section class="story">
            <div
                class="picture"
                style="background-image: url({{actor.img}});"
            >
                <img
                    src="{{actor.img}}"
                    title="{{actor.name}}"
                    data-action="editImage"
                    data-edit="img"
                />
            </div>
            <div class="about">
                <p><b>Imię:</b><input
                name="name"
                type="text"
                placeholder="Name"
                value="{{actor.name}}"
                /></p>
                <prose-mirror
                    name="system.story"
                    button="false"
                    editable="{{editable}}"
                    toggled="true"
                    value="{{system.story}}"
                >{{{system.story}}}
                </prose-mirror>
            </div>
        </section>
        <section class="gear">
            <h3>
                Przydział
            </h3>
            <div>
                <p>Pięści</p>
                {{#if (isBigger system.stats.Krzepa.curr 7)}}
                <p>2 obr.</p>
                {{else}}
                {{#if (isBigger system.stats.Krzepa.curr 3)}}
                <p>1 obr.</p>
                {{else}}
                <p>0 obr.</p>
                {{/if}}
                {{/if}}
                <p>+1 obr. (2)</p>
            </div>
            {{#each gears as |gear|}}
                {{> "systems/never-going-home/actors/soldier/parts/gear.hbs" gear}}
            {{/each}}
        </section>
        <section class="ruin">
            <h3>Spaczenie</h3>
            <div class="tracker">
                {{{loopTrack 0 system.ruin.max system.ruin.curr "system.ruin.curr" "desc"}}}
            </div>
        </section>
    </div>
    <div>
        <section class="skills">
            <h3>Wyszkolenie</h3>
            {{#each skills as |skill|}}
                {{> "systems/never-going-home/actors/soldier/parts/skill.hbs" skill}}
            {{/each}}
            <button data-action="addSkill">
                <i class="fa-solid fa-plus"></i>
                <p>Dodaj Wyszkolenie / Szepty</p>
            </button>
        </section>
        {{!-- <section class="notes">
            <h3>Zapis Służby</h3>
            <prose-mirror
                name="system.notes"
                button="false"
                editable="{{editable}}"
                toggled="true"
                value="{{system.notes}}"
            >{{{system.notes}}}
            </prose-mirror>
        </section> --}}
    </div>
    <section class="cards">
        <h3>Karty</h3>
        {{#each system.cards as |card|}}
            {{> "systems/never-going-home/actors/soldier/parts/card.hbs" card}}
        {{/each}}
        <button data-action="draw">Weź Kartę</button>
    </section>
</div>